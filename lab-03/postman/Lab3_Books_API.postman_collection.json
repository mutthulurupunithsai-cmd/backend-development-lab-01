{
  "info": {
    "name": "Lab 3 - Books REST API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "bookId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "1. Success cases",
      "item": [
        {
          "name": "T01 GET all books (defaults)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Response is JSON with a message\", function () { const j = pm.response.json(); pm.expect(j).to.have.property(\"message\"); });",
                  "pm.test(\"Defaults applied\", function(){ const j=pm.response.json(); pm.expect(j.limit).to.eql(10); pm.expect(j.offset).to.eql(0); });"
                ]
              }
            }
          ]
        },
        {
          "name": "T02 Search by title (search_q)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?search_q=code",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ],
              "query": [
                {
                  "key": "search_q",
                  "value": "code"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Response is JSON with a message\", function () { const j = pm.response.json(); pm.expect(j).to.have.property(\"message\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "T03 Sort by price DESC",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?order_by=price&order=DESC",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ],
              "query": [
                {
                  "key": "order_by",
                  "value": "price"
                },
                {
                  "key": "order",
                  "value": "DESC"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Response is JSON with a message\", function () { const j = pm.response.json(); pm.expect(j).to.have.property(\"message\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "T04 Pagination (limit=2, offset=1)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?limit=2&offset=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "2"
                },
                {
                  "key": "offset",
                  "value": "1"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Response is JSON with a message\", function () { const j = pm.response.json(); pm.expect(j).to.have.property(\"message\"); });",
                  "pm.test(\"At most 2 rows\", function(){ pm.expect(pm.response.json().data.length).to.be.at.most(2); });"
                ]
              }
            }
          ]
        },
        {
          "name": "T05 Price range (min=300, max=700)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?min_price=300&max_price=700",
              "host": [
                "{{baseUrl}}"
